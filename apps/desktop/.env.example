# Environment variables
NODE_ENV=development

# Database path
DB_PATH=

# Publish releases (contents:write on the repo / releases)
GH_TOKEN=

# Read-only fine-grained PAT baked into packaged clients (Contents: Read only)
UPDATE_GH_TOKEN=

# Install census for local dev only (.env.local). pnpm dist ignores this file.
REGISTRY_URL=http://127.0.0.1:8787
REGISTRY_INGEST_SECRET=dev-only-ingest-secret
