{
  "name": "@weight/desktop",
  "private": true,
  "version": "1.3.0",
  "description": "Weight Management System for weigh bridge workstations",
  "main": "dist/bootstrap.js",
  "type": "module",
  "publisher": "Victor Okenwa",
  "scripts": {
    "clean": "rimraf dist release",
    "inject-token": "node scripts/inject-update-token.mjs",
    "inject-registry": "node scripts/inject-registry-config.mjs",
    "inject-registry:packaged": "node scripts/inject-registry-config.mjs --packaged",
    "build": "pnpm inject-token && pnpm inject-registry && tsc",
    "watch": "tsc --watch",
    "electron": "electron .",
    "dev": "pnpm inject-registry && rimraf dist && concurrently \"pnpm watch\" \"wait-on dist/bootstrap.js && electronmon .\"",
    "dist": "pnpm inject-token && pnpm inject-registry:packaged && tsc && node scripts/wrap-electron-builder.mjs --win --publish never",
    "release": "pnpm inject-token && pnpm inject-registry:packaged && tsc && node scripts/wrap-electron-builder.mjs --win --publish always"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.28.2",
  "repository": {
    "type": "git",
    "url": "https://github.com/Victor-Okenwa/weight-management-desktop.git"
  },
  "dependencies": {
    "@serialport/parser-delimiter": "^13.0.0",
    "@serialport/parser-readline": "^13.0.0",
    "@weight/shared": "workspace:*",
    "@weight/database": "workspace:*",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.33.0",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.6.2",
    "serialport": "^13.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@types/node": "^24.12.3",
    "concurrently": "^9.2.1",
    "electron": "^42.0.1",
    "electron-builder": "^26.11.1",
    "electronmon": "^2.0.4",
    "rimraf": "^6.1.3",
    "tsx": "^4.21.0",
    "typescript": "catalog:",
    "wait-on": "^9.0.10"
  }
}
