{
  "name": "weight-management-system",
  "version": "1.3.0",
  "description": "",
  "main": "index.js",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ]
  },
  "scripts": {
    "dev": "turbo run dev --force",
    "build": "turbo run build",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "check": "biome check .",
    "release:win": "pnpm --filter @weight/renderer build && pnpm --filter @weight/desktop release",
    "dist:win": "pnpm --filter @weight/renderer build && pnpm --filter @weight/desktop dist"
  },
  "keywords": [],
  "author": "Victor-Okenwa",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.28.2",
  "catalog": {
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "turbo": "^2.9.12"
  }
}
